# Opcional: se definido, o pipeline também grava a camada prata no Neon e o
# dashboard passa a ler de lá. Sem ele, tudo funciona com o SQLite local.
DATABASE_URL=postgresql://<usuario>:<senha>@<host>.neon.tech/<banco>?sslmode=require

# Opcionais, usados na geração do site estático (python gerar_site.py)
SITE_URL=https://<seu-site>.netlify.app
REPO_URL=https://github.com/<usuario>/<repositorio>
